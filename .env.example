# =========================================================================
#  Especializate — Gateway LTI 1.3  ·  Variables de entorno (EJEMPLO)
#  Copiá este archivo a `.env` y completá los valores reales.
#  NUNCA subas el `.env` real al repositorio ni pongas secretos en el frontend.
# =========================================================================

# --- Entorno / servidor -------------------------------------------------
NODE_ENV=development
# Puerto donde escucha el gateway.
PORT=3000
# URL pública (https) desde la que se sirve este gateway + el aula.
# Es la base de TODAS las URLs que registrás en Moodle. Sin barra final.
# Ej. producción: https://aula.especializate.example
PUBLIC_BASE_URL=http://localhost:3000

# --- Ubicación del aula estática existente ------------------------------
# Ruta (absoluta o relativa a /backend) a la carpeta del aula que ya tenés.
# El gateway la sirve tal cual, sin modificarla.
AULA_DIR=./aula
# Página a la que se entra tras un lanzamiento válido. index.html es la
# pantalla EMBEBIDA (portada); su CTA lleva al recorrido (inicio.html).
AULA_ENTRY=/index.html
# Carpeta con el helper de cliente (auth.js) que el gateway inyecta en el aula.
AULA_CLIENT_DIR=./aula-client

# --- Datos de la plataforma (Moodle) — los provee el admin de Moodle ----
# "issuer" de tu Moodle. Suele ser la URL base del Moodle, SIN barra final.
# Debe coincidir EXACTO con el claim `iss` del id_token.  Ej: https://campus.tu-moodle.edu
LTI_ISSUER=
# client_id que Moodle asigna a esta herramienta al registrarla.
LTI_CLIENT_ID=
# deployment_id de este despliegue de la herramienta en Moodle.
LTI_DEPLOYMENT_ID=
# URL base de Moodle. Es la ÚNICA fuente para los botones "Ir a Moodle" /
# "Volver a Moodle" de las pantallas de acceso y sesión vencida (no se repite
# en ningún otro archivo). Si se deja vacío se usa LTI_ISSUER. Suele = LTI_ISSUER.
MOODLE_URL=

# --- Endpoints OIDC/JWKS de Moodle — los provee el admin de Moodle ------
# Authorization endpoint (a donde redirige el login OIDC). En Moodle:
#   {MOODLE_URL}/mod/lti/auth.php
LTI_AUTH_LOGIN_URL=
# JWKS público de Moodle (claves con las que se firma el id_token). En Moodle:
#   {MOODLE_URL}/mod/lti/certs.php
LTI_JWKS_URL=
# (Opcional) Token endpoint de Moodle, necesario SOLO para servicios LTI Advantage
# (AGS/NRPS) en fases futuras. En Moodle: {MOODLE_URL}/mod/lti/token.php
LTI_TOKEN_URL=

# --- Clave de la herramienta (tool keypair) para el JWKS propio ---------
# El gateway expone su JWKS público en {PUBLIC_BASE_URL}/lti/jwks.
# Podés pegar acá una clave privada PKCS8 (PEM) fija para producción,
# o dejarlo vacío en desarrollo y el gateway generará y persistirá una
# clave en ./.keys/ (gitignored) automáticamente.
# Pegá el PEM en una sola línea usando \n como saltos, o dejalo vacío.
LTI_TOOL_PRIVATE_KEY=
# Identificador de la clave (kid). Si generás la clave automáticamente se crea solo.
LTI_TOOL_KID=

# --- Sesión -------------------------------------------------------------
# Secreto para firmar la cookie de sesión. Generá uno largo y aleatorio.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Nombre de la cookie de sesión.
SESSION_COOKIE_NAME=especializate_lti_sid
# Minutos de vida de la sesión.
SESSION_TTL_MIN=240
# ¿Moodle abre el aula DENTRO de un iframe? Si es así, la cookie necesita
# SameSite=None; Secure (requiere https). true / false.
EMBED_IN_IFRAME=false

# --- Progreso (persistencia) --------------------------------------------
# 'local'  → el progreso vive sólo en el navegador (idéntico a hoy). Por defecto.
# 'remote' → servidor = persistencia principal, localStorage = caché.
# Dejalo en 'local' hasta elegir la tecnología de almacenamiento remoto.
PROGRESS_MODE=local
# Implementación del store en el backend (placeholders por ahora): memory | file
#   memory → volátil, se pierde al reiniciar (demo/dev).
#   file   → un JSON por estudiante en PROGRESS_DATA_DIR (durable, 1 instancia).
PROGRESS_STORE=memory
# Carpeta de datos para PROGRESS_STORE=file.
PROGRESS_DATA_DIR=./.data

# --- Desarrollo ---------------------------------------------------------
# SOLO para probar el aula sin un Moodle real. Si es "true" Y NODE_ENV!=production,
# habilita la ruta /dev/launch que simula un lanzamiento. NUNCA en producción.
DEV_FAKE_LAUNCH=false
